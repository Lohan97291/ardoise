# Assistant IA Ardoise
# Remplir la clé OpenAI puis relancer l'application.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Mot de passe unique pour accéder à l'application (protège pages + API).
# Laisser vide en dev pour désactiver la protection.
APP_PASSWORD=replace-with-a-strong-password

# Secret partagé avec le workflow n8n qui envoie les mails analysés vers Ardoise.
N8N_INGEST_SECRET=replace-with-your-n8n-shared-secret
