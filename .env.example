# Assistant IA Ardoise
# Remplir les clés puis relancer l'application.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Mot de passe unique pour accéder à l'application (protège pages + API).
# Laisser vide en dev pour désactiver la protection.
APP_PASSWORD=replace-with-a-strong-password

# Supabase (lecture navigateur + serveur).
VITE_SUPABASE_URL=replace-with-your-supabase-project-url
VITE_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Optionnel : alias serveur si tu préfères séparer les variables backend.
# SUPABASE_URL=replace-with-your-supabase-project-url
# SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Google Calendar OAuth.
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
# Optionnel : si vide, Ardoise utilise automatiquement l'URL du site courant.
# GOOGLE_REDIRECT_URI=https://your-domain/api/calendar/google/callback
# Optionnel : secret dédié au chiffrement du jeton Google.
# Si vide, APP_PASSWORD sera utilisé comme secours.
# GOOGLE_TOKEN_ENCRYPTION_SECRET=replace-with-a-dedicated-secret

# Secret partagé avec le workflow n8n qui envoie les mails analysés vers Ardoise.
N8N_INGEST_SECRET=replace-with-your-n8n-shared-secret
